#lang rzk-1

#def Δ¹_b
  : <| _b | 2 → TOPE |>
  := mod _b (\ t → TOP)

#def dhom'
  ( A : 2 → U)
  ( x : A 0₂)
  ( y : A 1₂)
  : U
  :=
    ( t : 2)
  → ( A t) [ t ≡ 0₂ ↦ x
          , t ≡ 1₂ ↦ y]

#def dhom_b
  : <| _b | (A : 2 → U) → (x : A 0₂) → (y : A 1₂) → U |>
  := mod _b (\ (A : 2 → U) → \ (x : A 0₂) → \ (y : A 1₂) → (t : \ (i : 2) → TOP) → (A t) [ t ≡ 0₂ ↦ x , t ≡ 1₂ ↦ y])

#def equiv-to-iff (A B : U) (e : Equiv A B)
  : iff A B
  :=
  ( first e , first (second (second e)))

#def ^I (A : U)
  : U
  := 2 → A

#def ^I_b ((mod _b A) : <| _b | U |>)
  : <| _b | U |>
  := mod _b (2 → A)

#postulate _I (A : <| _b | U |>)
  : <| _b | U |>

#postulate I-eta_b
  : <| _b |  (A : <| _b | U |>) → (x : 2 → (extract _b (_I A))) → extract _b A |>

#postulate I-transpose-equiv-comp ((mod _b A) : <| _b | U |>) ((mod _b B) : <| _b | U |>)
  : is-equiv <| _b | B → (extract _b (_I (mod _b A))) |> <| _b | (2 → B) → A |>
  (\f -> mod _b (\(g : 2 -> B) -> (extract _b I-eta_b) (mod _b A) (\i -> (extract _b f) (g i))))

#def I-transpose-equiv ((mod _b A) : <| _b | U |>) ((mod _b B) : <| _b | U |>)
  : Equiv <| _b | B → (extract _b (_I (mod _b A))) |> <| _b | (2 → B) → A |> :=
  ((\f -> mod _b (\(g : 2 -> B) -> (extract _b I-eta_b) (mod _b A) (\i -> (extract _b f) (g i))))
  , I-transpose-equiv-comp (mod _b A) (mod _b B))

#def I-transpose (A B : <| _b | U |>)
  : iff <| _b | extract _b B → extract _b (_I A) |> <| _b | (extract _b (^I_b B)) → extract _b A |>
  :=
  equiv-to-iff
    <| _b | extract _b B → extract _b (_I A) |>
    <| _b | (extract _b ( ^I_b B)) → extract _b A |>
    (I-transpose-equiv A B)

#def _I-functorial-pure (A : <| _b | U |>) (a : <| _b | extract _b A |>)
  : ( extract _b (_I A))
  :=
    #let transpose
      : <| _b | (2 → Unit) → extract _b A |> → <| _b | Unit → extract _b (_I A) |>
      := second (I-transpose A (mod _b Unit))
    #in
    (extract _b (transpose (mod _b (\ _ → extract _b a)))) unit

#def _I-functorial-pure_b (A : <| _b | U |>) (a : <| _b | extract _b A |>)
  : <| _b | ( extract _b (_I A)) |>
  :=
    mod _b ((extract _b ((second (I-transpose A (mod _b Unit))) (mod _b (\ _ → extract _b a)))) unit)

#def _I-functorial-fmap (A B : <| _b | U |>) (f : <| _b | (extract _b A) → (extract _b B) |>)
  : <| _b | extract _b (_I A) → extract _b (_I B) |>
  :=
  ( second (I-transpose B (_I A))) (mod _b (\ (p : 2 → extract _b (_I A))
  → ( extract _b f)
  ( ( extract _b I-eta_b) (mod _b (extract _b A)) p)))

#def is-contr_b
  : <| _b | U → U |>
  := mod _b (\ (A : U) → Σ (x : A) , ((y : A) → x = y))

#def is-cov (X : U) (A : X → U)
  : U
  := (x : 2 → X) → (a_0 : A (x 0₂)) → is-contr (Σ (a_1 : A (x 1₂)) , dhom' (\ i → A (x i)) a_0 a_1)

#def is-cov-i (A : 2 → U)
  : U
  := (a_0 : A 0₂) → is-contr (Σ (a_1 : A (1₂)) , dhom' (\ i → A i) a_0 a_1)

#def U_b
  : <| _b | U |>
  := mod _b U

#def is-cov-i_b
  : <| _b | (extract _b (^I_b U_b)) → U |>
  := mod _b (\ (A : extract _b (^I_b U_b)) → (a_0 : A 0₂) → (extract _b is-contr_b) (Σ (a_1 : A (1₂)) , (extract _b dhom_b) (\ i → A i) a_0 a_1))

#def univ-family
  : U
  := Σ (A : U) , A

#def univ-family_b
  : <| _b | U |>
  := mod _b (Σ (A : U) , A)

#def univ-family-proj
  : univ-family → U
  :=
  \ x → first x

#def univ-family-proj-1_i
  : extract _b (_I univ-family_b) → extract _b (_I U_b)
  := extract _b (_I-functorial-fmap univ-family_b U_b (mod _b (\ x → first x)))

-- #def univ-family-proj-2_i
--  : (u : extract _b (_I univ-family_b)) → univ-family-proj-1_i u
--  := extract _b (_I-functorial-fmap univ-family_b U_b (mod _b (\ x → first x)))

#def univ-family-proj-1_i_b
  : <| _b | extract _b (_I univ-family_b) → extract _b (_I U_b) |>
  := (_I-functorial-fmap univ-family_b U_b (mod _b (\ x → first x)))

#def dep-i
  : ( extract _b (_I U_b)) → U
  :=
  \ b → fib (extract _b (_I (univ-family_b))) (extract _b (_I U_b))
  ( univ-family-proj-1_i) b

#def fib_b
  : <| _b | (A : U) → (B : U) → (f : A → B) → (b : B) → U |>
  := mod _b (\ (A : U) → \ (B : U) → \ (f : A → B) → \ (b : B) → Σ (a : A) , (f a) = b)

#def dep-i_b
  : <| _b | (extract _b (_I U_b)) → U |>
  :=
  mod _b (\ b → (extract _b fib_b) (extract _b (_I (univ-family_b))) (extract _b (_I U_b))
  ( extract _b univ-family-proj-1_i_b) b)

#def is-a-cov (X : U)
  : U
  := dep-i ((extract _b ((second (I-transpose U_b U_b)) is-cov-i_b)) X)

#compute-nf is-a-cov

#def is-a-cov_b
  : <| _b | U → U |>
  := mod _b (\ X → (extract _b dep-i_b) ((extract _b ((second (I-transpose U_b U_b)) is-cov-i_b)) X))

#def S
  : U
  := Σ (A : U) , is-a-cov A

#def S_b
  : <| _b | U |>
  := mod _b (Σ (A : U) , (extract _b is-a-cov_b) A)

#def coe (X : U) (A : X → U) (phi : is-cov X A) (x0 x1 : X) (f : hom X x0 x1)
  : A x0 → A x1
  :=
  \ a0 → first (first (phi f a0))

#def coe-i (A : 2 → U) (phi : is-cov-i A)
  : A 0₂ → A 1₂
  :=
  \ a0 → first (first (phi a0))

#postulate ua (A B : U)
  : Equiv (Equiv A B) (A = B)

#def equiv-unit-arrow
  (X : U)
  : Equiv (Unit → X) X
  :=
    ( \ f → f unit
    , ( (\ x _ → x , \ _ → refl)
      , (\ x _ → x , \ _ → refl)))


#postulate crisp-induction-flat (A : <| _b | U |>) (x y : <| _b | extract _b A |>) : <| _b | (extract _b x) = (extract _b y) |> -> x = y

#def equiv-ap-type
  (f : U → U)
  (A B : U)
  (e : Equiv A B)
  : Equiv (f A) (f B)
  :=
    equiv-transport U f A B
      (first (ua A B) e)

#postulate prop-eq-in_I : <| _b | (s : extract _b S_b) -> ((extract _b (second (I-transpose U_b U_b) is-cov-i_b)) (first s) = extract _b (second (I-transpose U_b S_b) (mod _b (\ h -> Unit))) s) |>

#def is-equiv_b
    : <| _b |
        ( A : U) -> (B : U)
      → ( f : A → B)
      → U
      |>
    := mod _b
         ( \ A B f →
           Σ ( _ : Σ (r : B → A) , (a : A) → r (f a) = a)
           , Σ (s : B → A) , (b : B) → f (s b) = b)

#def htpy-eq_b
    : <| _b |
        ( X : U)
      → ( A : X → U)
      → ( f : (x : X) → A x)
      -> (g : (x : X) -> A x)
      → ( f = g)
      → ( (x : X) → f x = g x)
      |>
    := mod _b
         ( \ X A f g p →
           idJ
             ( ( x : X) → A x
             , f
             , \ g' p' → (x : X) → f x = g' x
             , \ x → refl
             , g
             , p))

#def FunExt_b
    : <| _b | U |>
    :=
      mod _b (
        ( X : U)
      → ( A : X → U)
      → ( f : (x : X) → A x)
      → ( g : (x : X) → A x)
      → (extract _b is-equiv_b) (f = g) ((x : X) → f x = g x) ((extract _b htpy-eq_b) X A f g)
      )


#postulate funext_b : <| _b | extract _b FunExt_b |>

#def eq-htpy_b
  : <| _b |
        ( X : U)
      → ( A : X → U)
      → ( f : (x : X) → A x)
      -> ( g : (x : X) -> A x)
      → ( (x : X) → f x = g x)
      → ( f = g)
      |>
    := mod _b
         ( \ X A f g →
           first (first ((extract _b funext_b) X A f g)))

#def transpose-eq-is-cov_b :
  ((first (I-transpose U_b S_b)) (mod _b (\ (s : extract _b S_b) → (extract _b ((second (I-transpose U_b U_b)) is-cov-i_b)) (first s)))
  =
  mod _b (\(h : (2 -> extract _b S_b)) -> (extract _b is-cov-i_b) (\ b → first (h b))))
  := ap
    <| _b | (2 → extract _b U_b) → U |>
    <| _b | (2 → extract _b S_b) → U |>
    ((first (I-transpose U_b U_b)) (second (I-transpose U_b U_b) is-cov-i_b ))
    is-cov-i_b
    ( \ g -> mod _b (\ h → (extract _b g) (\ i → first (h i))))
    ((second (second (second (I-transpose-equiv U_b U_b)))) is-cov-i_b)


#def transpose-eq-is-cov
  : extract _b ((first (I-transpose U_b S_b)) (mod _b (\ (s : extract _b S_b) → (extract _b ((second (I-transpose U_b U_b)) is-cov-i_b)) (first s))))
  = (\ h → (extract _b is-cov-i_b) (\ b → first (h b)))
  := ap
      <| _b | (2 → extract _b S_b) → U |>
      ((2 → extract _b S_b) → U)
      ((first (I-transpose U_b S_b)) (mod _b (\ (s : extract _b S_b) → (extract _b ((second (I-transpose U_b U_b)) is-cov-i_b)) (first s))))
      (mod _b (\ (h : (2 → extract _b S_b)) → (extract _b is-cov-i_b) (\ b → first (h b))))
      (\x -> extract _b x)
      transpose-eq-is-cov_b


#def transpose-eq-is-pure_b
  : first (I-transpose U_b S_b) (second (I-transpose U_b S_b) (mod _b (\ h -> Unit)))
  = (mod _b (\ h → Unit))
  :=  ((second (second (second (I-transpose-equiv U_b S_b)))) (mod _b (\ h → Unit)))

#def transpose-eq-pure
  : extract _b (first (I-transpose U_b S_b) (second (I-transpose U_b S_b) (mod _b (\ h -> Unit))))
  = (\ _ → Unit)
  := ap
      <| _b | (2 → extract _b S_b) → U |>
      ((2 → extract _b S_b) → U)
      (first (I-transpose U_b S_b) (second (I-transpose U_b S_b) (mod _b (\ h -> Unit))))
      (mod _b (\ (_ : (2 → extract _b S_b)) → Unit))
      (\x -> extract _b x)
      transpose-eq-is-pure_b


#def s-is-cov-i (f : 2 → S)
  : is-cov-i (\ b → first (f b))
  :=
    #let S-to-U
      := mod _b (\ (s : extract _b S_b) → first s) #in
    #let S-to-Unit_i
      := second (I-transpose (mod _b Unit) S_b) (mod _b (\ (s : 2 -> extract _b S_b) → unit))
    #in
    #let U-to-U_i
      := mod _b (\ (x : U) → (extract _b ((second (I-transpose U_b U_b)) is-cov-i_b)) x) #in
    #let Unit_i-to-U_i
      := second (I-transpose U_b (_I (mod _b Unit))) (mod _b (\ (u : 2 -> extract _b (_I mod _b (Unit))) → Unit)) #in
    #let f0 := mod _b (\(s : extract _b S_b) -> (extract _b U-to-U_i) ((extract _b S-to-U) s)) #in
    #let f1 := second (I-transpose U_b S_b) (mod _b (\ h -> Unit)) #in
    #let S-is-pullback
      : <| _b | ( s : extract _b S_b) → (extract _b f0) s = (extract _b f1) s |>
      := mod _b (\ s → extract _b (prop-eq-in_I) s)
    #in
    #let f0=f1
      : f0 = f1
      :=
        crisp-induction-flat
          (mod _b (extract _b S_b -> extract _b (_I (U_b))))
          (f0) (f1)
          (mod _b ((extract _b eq-htpy_b) (extract _b S_b) (\_ -> extract _b (_I (U_b))) (extract _b f0) (extract _b f1) (extract _b S-is-pullback)))
    #in
    #let transposed-eq
      : (\(h : (2 -> S)) -> is-cov-i (\ b → first (h b))) = (\(h : (2 -> S)) -> Unit)
      := concat
          ((2 → S) → U)
          (\h -> is-cov-i (\ b → first (h b)))
          (extract _b (first (I-transpose U_b S_b) f0))
          (\_ -> Unit)
          ( rev
            ((2 → S) → U)
            (extract _b (first (I-transpose U_b S_b) f0))
            (\h -> is-cov-i (\ b → first (h b)))
            transpose-eq-is-cov)
          ( concat
            ((2 → S) → U)
            (extract _b (first (I-transpose U_b S_b) f0))
            (extract _b (first (I-transpose U_b S_b) f1))
            (\_ -> Unit)
            ( ap
              (<| _b | extract _b S_b -> extract _b (_I U_b) |>)
              ((2 -> S) -> U)
              f0 f1
              (\f -> extract _b (first (I-transpose U_b S_b) f))
              f0=f1)
            transpose-eq-pure)
    #in
    transport U (\A -> A)
      Unit (is-cov-i (\ b → first (f b)))
      ( rev U
        (is-cov-i (\ b → first (f b)))
        Unit
        (htpy-eq
          (2 -> S)
          (\_ -> U)
          (\h -> is-cov-i (\ b → first (h b)))
          (\h -> Unit)
          transposed-eq
          f))
      unit

#def mor2fun (f : 2 → S)
  : Σ ( A : S) , (Σ (B : S) , (first A) → (first B))
  :=
  ( f 0₂ , (f 1₂ , coe-i (\ x → first (f x)) (s-is-cov-i f)))
