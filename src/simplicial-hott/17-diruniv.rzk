#lang rzk-1

#def dhom'
  ( A : 2 → U)
  ( x : A 0₂)
  ( y : A 1₂)
  : U
  :=
    ( t : 2)
  → ( A t) [ t ≡ 0₂ ↦ x
          , t ≡ 1₂ ↦ y]

#def equiv-to-iff (A B : U) (e : Equiv A B)
  : iff A B
  :=
  ( first e , first (second (second e)))

#def ^I (A : U)
  : U
  := 2 → A

#postulate _I (A : <| _b | U |>)
  : <| _b | U |>

#postulate I-eta
  : <| _b |  (A : _b U) → (x : 2 → (b-extract (mod _b U) (_I (mod _b A)))) → A |>

#postulate I-transpose-equiv-comp (A : _b U) (B : _b U)
  : is-equiv <| _b | B → (b-extract (mod _b U) (_I (mod _b A))) |> <| _b | (2 → B) → A |>
  ( \ (f : _b B → (b-extract (mod _b U) (_I (mod _b A)))) → mod _b (\ (g : 2 → B) →
      (#let mod _b eta := I-eta #in eta) (mod _b A)
      (\ i → f (g i))))

#def I-transpose-equiv (A : _b U) (B : _b U)
  : Equiv <| _b | B → (b-extract (mod _b U) (_I (mod _b A))) |> <| _b | (2 → B) → A |>
  :=
  ( ( \ (f : _b B → (b-extract (mod _b U) (_I (mod _b A)))) → mod _b (\ (g : 2 → B) →
        (#let mod _b eta := I-eta #in eta) (mod _b A)
        (\ i → f (g i))))
  , I-transpose-equiv-comp (mod _b A) (mod _b B))

#def I-transpose (A B : _b U)
  : iff <| _b | B → b-extract (mod _b U) (_I (mod _b A)) |> <| _b | (^I B) → A |>
  :=
  equiv-to-iff
    <| _b | B → b-extract (mod _b U) (_I (mod _b A)) |>
    <| _b | (^I B) → A |>
    ( I-transpose-equiv (mod _b A) (mod _b B))

#def _I-functorial-pure (A : _b U) (a : _b A)
  : b-extract (mod _b U) (_I (mod _b A))
  :=
    #let transpose
      : <| _b | (2 → Unit) → A |> → <| _b | Unit → b-extract (mod _b U) (_I (mod _b A)) |>
      := second (I-transpose (mod _b A) (mod _b Unit))
    #in
    #let mod _b tr := transpose (mod _b (\ _ → a)) #in
    tr unit

#def _I-functorial-pure_b (A : _b U) (a : _b A)
  : <| _b | b-extract (mod _b U) (_I (mod _b A)) |>
  :=
    #let mod _b tr := (second (I-transpose (mod _b A) (mod _b Unit))) (mod _b (\ _ → a)) #in
    mod _b (tr unit)

#def _I-functorial-fmap (A B : _b U) (f : _b A → B)
  : <| _b | b-extract (mod _b U) (_I (mod _b A)) → b-extract (mod _b U) (_I (mod _b B)) |>
  :=
  ( second (I-transpose (mod _b B) (_I (mod _b A))))
    (mod _b (\ (p : 2 → b-extract (mod _b U) (_I (mod _b A))) -> #let mod _b eta := I-eta #in f (eta (mod _b A) p)))

#postulate funext : FunExt
#postulate weakfunext : WeakFunExt

#def is-cov (X : U) (A : X → U)
  : U
  := (x : 2 → X) → (a_0 : A (x 0₂)) → is-contr (Σ (a_1 : A (x 1₂)) , dhom' (\ i → A (x i)) a_0 a_1)

#def is-cov-i (A : 2 → U)
  : U
  := (a_0 : A 0₂) → is-contr (Σ (a_1 : A (1₂)) , dhom' (\ i → A i) a_0 a_1)

#postulate is-prop-is-cov-i : (A : 2 → U) → is-prop (is-cov-i A)

#def Ub
  : <| _b | U |>
  := mod _b U

#def prop
  : U
  := Σ (A : U) , is-prop A

#def univ-family-prop
  : U
  := Σ (A : prop) , (first A)

#def univ-family-proj-1
  : univ-family-prop → prop
  :=
  \ x → first x

#def univ-family-proj-1_i
  : b-extract (mod _b U) (_I (mod _b univ-family-prop)) → b-extract (mod _b U) (_I (mod _b prop))
  := #let mod _b fmap := _I-functorial-fmap (mod _b univ-family-prop) (mod _b prop) (mod _b (\ x → first x)) #in fmap

#def dep-i
  : ( b-extract (mod _b U) (_I (mod _b prop))) → U
  :=
  \ b →
    fib
      ( b-extract (mod _b U) (_I (mod _b univ-family-prop)))
      ( b-extract (mod _b U) (_I (mod _b prop)))
      ( univ-family-proj-1_i)
      ( b)

#def is-a-cov (X : U)
  : U
  :=
    dep-i
      (#let mod _b cov-map := (second (I-transpose (mod _b prop) Ub))
                               (mod _b (\x -> (is-cov-i x, is-prop-is-cov-i x))) #in cov-map X)

#def S
  : U
  := Σ (A : U) , is-a-cov A

#def coe (X : U) (A : X → U) (phi : is-cov X A) (x0 x1 : X) (f : hom X x0 x1)
  : A x0 → A x1
  :=
  \ a0 → first (first (phi f a0))

#def coe-i (A : 2 → U) (phi : is-cov-i A)
  : A 0₂ → A 1₂
  :=
  \ a0 → first (first (phi a0))

#postulate ua (A B : U)
  : Equiv (Equiv A B) (A = B)

#def equiv-unit-arrow
  ( X : U)
  : Equiv (Unit → X) X
  :=
    ( \ f → f unit
    , ( ( \ x _ → x , \ _ → refl)
      , ( \ x _ → x , \ _ → refl)))

#postulate crisp-induction-flat (A : _b U ) (x y : _b A )
  : <| _b | x = y |> → (mod _b x) = (mod _b y)

#postulate crisp-induction-flat-rev : (A : _b U) -> (x : _b A) -> (y : _b  A) -> ((mod _b x) = (mod _b y)) -> <| _b | x = y |>

#def equiv-ap-type
  ( f : U → U)
  ( A B : U)
  ( e : Equiv A B)
  : Equiv (f A) (f B)
  :=
    equiv-transport U f A B
      ( first (ua A B) e)

#def univ-family-prop-is-contr
  : is-contr (univ-family-prop)
  :=
    ( ( (Unit, is-prop-Unit), unit)
    , \ x →
      #let A := first (first x) #in
      #let p := second (first x) #in
      #let a := second x #in
      #let path-UA :=
        first (ua Unit A)
          ( \ _ → a
          , ( ( \ _ → unit, \ _ → refl)
            , ( \ _ → unit, \ y → first (p a y))))
      #in
      #let path-prop :=
        eq-pair U (\ T → is-prop T) (Unit, is-prop-Unit) (first x)
          ( path-UA
          , first (is-prop-is-prop funext weakfunext A
              ( transport U (\ T → is-prop T) Unit A path-UA is-prop-Unit)
              ( p)))
      #in
        eq-pair prop (\ Q → first Q) ((Unit, is-prop-Unit), unit) x
          ( path-prop
          , first (p
              ( transport prop (\ Q → first Q) (Unit, is-prop-Unit) (first x)
                  path-prop unit)
              ( a))))

#def univ-family-prop-first-const-Unit
  :
    (\(x : univ-family-prop) -> first x)
    = (\(x : univ-family-prop) -> (Unit, is-prop-Unit))
  :=
    eq-htpy funext univ-family-prop (\ _ → prop)
      ( \ x → first x) (\ x → (Unit, is-prop-Unit))
      ( \ x →
        rev prop (Unit, is-prop-Unit) (first x)
          ( ap univ-family-prop prop
            ( ( Unit, is-prop-Unit), unit) x
            ( \ y → first y)
            ( second univ-family-prop-is-contr x)))


#def proj_1-i=transposed-const-Unit
  :
    univ-family-proj-1_i
    = (#let mod _b tr := (second (I-transpose (mod _b prop) (_I (mod _b univ-family-prop)))) (mod _b (\h → (Unit, is-prop-Unit))) #in tr)
  :=
    ap
      <| _b | univ-family-prop → prop |>
      ( b-extract (mod _b U) (_I (mod _b univ-family-prop)) → b-extract (mod _b U) (_I (mod _b prop)))
      ( mod _b (\ x → first x))
      ( mod _b (\ x → (Unit, is-prop-Unit)))
      ( \ f → #let mod _b fmap := _I-functorial-fmap (mod _b univ-family-prop) (mod _b prop) f #in fmap)
      ( crisp-induction-flat
        ( mod _b (univ-family-prop → prop))
        ( mod _b (\ x → first x))
        ( mod _b (\ x → (Unit, is-prop-Unit)))
        ( mod _b univ-family-prop-first-const-Unit))

#def is-cov-i-t-first=const-Unit
  : <| _b | (s : S) ->
      (#let mod _b cov-map := (second (I-transpose (mod _b prop) Ub)) (mod _b (\x -> (is-cov-i x, is-prop-is-cov-i x))) #in cov-map (first s))
      = (#let mod _b const-map := (second (I-transpose (mod _b prop) (_I (mod _b univ-family-prop)))) (mod _b (\h → (Unit, is-prop-Unit))) #in const-map (first (second s))) |>
  := mod _b (\ s →
    #let mod _b cov-map := (second (I-transpose (mod _b prop) Ub)) (mod _b (\x -> (is-cov-i x, is-prop-is-cov-i x))) #in
    #let mod _b const-map := (second (I-transpose (mod _b prop) (_I (mod _b univ-family-prop)))) (mod _b (\h → (Unit, is-prop-Unit))) #in
    concat
      ( b-extract (mod _b U) (_I (mod _b prop)))
      ( cov-map (first s))
      ( univ-family-proj-1_i (first (second s)))
      ( const-map (first (second s)))
      ( rev (b-extract (mod _b U) (_I (mod _b prop)))
        ( univ-family-proj-1_i (first (second s)))
        ( cov-map (first s))
        ( second (second s)))
      ( htpy-eq
        ( b-extract (mod _b U) (_I (mod _b univ-family-prop)))
        ( \ _ → b-extract (mod _b U) (_I (mod _b prop)))
        ( univ-family-proj-1_i)
        ( const-map)
        ( proj_1-i=transposed-const-Unit)
        ( first (second s))))


#def last-step
  : <| _b | ( s : S) ->
      (#let mod _b const-map := (second (I-transpose (mod _b prop) (_I (mod _b univ-family-prop)))) (mod _b (\h → (Unit, is-prop-Unit))) #in const-map (first (second s)))
      = (#let mod _b pure-map := (second (I-transpose (mod _b prop) (mod _b S))) (mod _b (\ h → (Unit, is-prop-Unit))) #in pure-map s) |>
  := mod _b (
    \s ->
      #let mod _b const-map := (second (I-transpose (mod _b prop) (_I (mod _b univ-family-prop)))) (mod _b (\h → (Unit, is-prop-Unit))) #in
      #let mod _b pure-map := (second (I-transpose (mod _b prop) (mod _b S))) (mod _b (\ h → (Unit, is-prop-Unit))) #in
      #let lhs-inverse=const-unit
        : (first (I-transpose (mod _b prop) (mod _b S))) (mod _b (\sh -> const-map (first (second sh))))
        = mod _b (\(_ : 2 → S) → (Unit, is-prop-Unit))
      := ap
           <| _b | (2 → b-extract (mod _b U) (_I (mod _b univ-family-prop))) → prop |>
           <| _b | (2 → S) → prop |>
           ( first (I-transpose (mod _b prop) (_I (mod _b univ-family-prop)))
             ( second (I-transpose (mod _b prop) (_I (mod _b univ-family-prop)))
               ( mod _b (\_ → (Unit, is-prop-Unit)))))
           ( mod _b (\_ → (Unit, is-prop-Unit)))
           ( \ F → #let mod _b fun := F #in mod _b (\(p : 2 → S) → fun (\(i : 2) → first (second (p i)))))
           ( ( second (second (second (I-transpose-equiv (mod _b prop) (_I (mod _b univ-family-prop))))))
             ( mod _b (\_ → (Unit, is-prop-Unit))))
      #in
      #let rhs-inverse=const-unit
        : (first (I-transpose (mod _b prop) (mod _b S))) (mod _b (\sh -> pure-map sh))
        = mod _b (\(_ : 2 → S) → (Unit, is-prop-Unit))
      := ( second (second (second (I-transpose-equiv (mod _b prop) (mod _b S)))))
           ( mod _b (\_ → (Unit, is-prop-Unit)))
      #in
      #let transpose-f=transpose-g
        := concat
            <| _b | (2 → S) → prop |>
            ( (first (I-transpose (mod _b prop) (mod _b S))) (mod _b (\sh -> const-map (first (second sh)))))
            ( mod _b (\(_ : 2 → S) → (Unit, is-prop-Unit)))
            ( (first (I-transpose (mod _b prop) (mod _b S))) (mod _b (\sh -> pure-map sh)))
            lhs-inverse=const-unit
            ( rev <| _b | (2 → S) → prop |>
              ( (first (I-transpose (mod _b prop) (mod _b S))) (mod _b (\sh -> pure-map sh)))
              ( mod _b (\(_ : 2 → S) → (Unit, is-prop-Unit)))
              rhs-inverse=const-unit)
      #in
      #let f=g
        := inv-ap-is-emb
            <| _b | S → b-extract (mod _b U) (_I (mod _b prop)) |>
            <| _b | (2 → S) → prop |>
            ( first (I-transpose-equiv (mod _b prop) (mod _b S)))
            ( is-emb-is-equiv
              <| _b | S → b-extract (mod _b U) (_I (mod _b prop)) |>
              <| _b | (2 → S) → prop |>
              ( first (I-transpose-equiv (mod _b prop) (mod _b S)))
              ( I-transpose-equiv-comp (mod _b prop) (mod _b S)))
            ( mod _b (\sh -> const-map (first (second sh))))
            ( mod _b (\sh -> pure-map sh))
            transpose-f=transpose-g
      #in
      ap
        <| _b | S → b-extract (mod _b U) (_I (mod _b prop)) |>
        ( b-extract (mod _b U) (_I (mod _b prop)))
        ( mod _b (\ sh → const-map (first (second sh))))
        ( mod _b (\ sh → pure-map sh))
        ( \ F → #let mod _b f := F #in f s)
        f=g

    )

#def prop-eq-in_I
  : <| _b | (s : S) →
      (#let mod _b cov-map := (second (I-transpose (mod _b prop) Ub)) (mod _b (\x -> (is-cov-i x, is-prop-is-cov-i x))) #in cov-map (first s))
      = (#let mod _b pure-map := (second (I-transpose (mod _b prop) (mod _b S))) (mod _b (\ h → (Unit, is-prop-Unit))) #in pure-map s) |>
  := mod _b (\s ->
    #let mod _b cov-map := (second (I-transpose (mod _b prop) Ub)) (mod _b (\x -> (is-cov-i x, is-prop-is-cov-i x))) #in
    #let mod _b const-map := (second (I-transpose (mod _b prop) (_I (mod _b univ-family-prop)))) (mod _b (\h → (Unit, is-prop-Unit))) #in
    #let mod _b pure-map := (second (I-transpose (mod _b prop) (mod _b S))) (mod _b (\ h → (Unit, is-prop-Unit))) #in
    #let mod _b step1 := is-cov-i-t-first=const-Unit #in
    #let mod _b step2 := last-step #in
    concat
      (b-extract (mod _b U) (_I (mod _b prop)))
      (cov-map (first s))
      (const-map (first (second s)))
      (pure-map s)
      (step1 s)
      (step2 s)
  )

#def transpose-eq-is-cov_b
  :
  ( ( first (I-transpose (mod _b prop) (mod _b S))) (mod _b (\ (s : S) → #let mod _b cov-map := (second (I-transpose (mod _b prop) Ub)) (mod _b (\x -> (is-cov-i x, is-prop-is-cov-i x))) #in cov-map (first s)))
  = mod _b (\ (h : (2 → S)) → (is-cov-i (\ b → first (h b)), is-prop-is-cov-i (\ b → first (h b)))))
  := ap
    <| _b | (2 → U) → prop |>
    <| _b | (2 → S) → prop |>
    ( ( first (I-transpose (mod _b prop) Ub)) (second (I-transpose (mod _b prop) Ub) (mod _b (\x -> (is-cov-i x, is-prop-is-cov-i x)))))
    ( mod _b (\x -> (is-cov-i x, is-prop-is-cov-i x)))
    ( \ g → #let mod _b g' := g #in mod _b (\ h → (g') (\ i → first (h i))))
    ( ( second (second (second (I-transpose-equiv (mod _b prop) Ub)))) (mod _b (\x -> (is-cov-i x, is-prop-is-cov-i x))))


#def transpose-eq-is-cov
  : (#let mod _b lhs := (first (I-transpose (mod _b prop) (mod _b S))) (mod _b (\ (s : S) → #let mod _b cov-map := (second (I-transpose (mod _b prop) Ub)) (mod _b (\x -> (is-cov-i x, is-prop-is-cov-i x))) #in cov-map (first s))) #in lhs)
  = ( \ h → (is-cov-i (\ b → first (h b)), is-prop-is-cov-i (\ b → first (h b))))
  := ap
      <| _b | (2 → S) → prop |>
      ( ( 2 → S) → prop)
      ( ( first (I-transpose (mod _b prop) (mod _b S))) (mod _b (\ (s : S) → #let mod _b cov-map := (second (I-transpose (mod _b prop) Ub)) (mod _b (\x -> (is-cov-i x, is-prop-is-cov-i x))) #in cov-map (first s))))
      ( mod _b (\ (h : (2 → S)) → (is-cov-i (\ b → first (h b)), is-prop-is-cov-i (\ b → first (h b)))))
      ( \ x → #let mod _b x' := x #in x')
      transpose-eq-is-cov_b


#def transpose-eq-is-pure_b
  : first (I-transpose (mod _b prop) (mod _b S)) (second (I-transpose (mod _b prop) (mod _b S)) (mod _b (\ h → (Unit, is-prop-Unit))))
  = ( mod _b (\ h → (Unit, is-prop-Unit)))
  := ((second (second (second (I-transpose-equiv (mod _b prop) (mod _b S))))) (mod _b (\ h → (Unit, is-prop-Unit))))

#def transpose-eq-pure
  : (#let mod _b lhs := first (I-transpose (mod _b prop) (mod _b S)) (second (I-transpose (mod _b prop) (mod _b S)) (mod _b (\ h → (Unit, is-prop-Unit)))) #in lhs)
  = ( \ _ → (Unit, is-prop-Unit))
  := ap
      <| _b | (2 → S) → prop |>
      ( ( 2 → S) → prop)
      ( first (I-transpose (mod _b prop) (mod _b S)) (second (I-transpose (mod _b prop) (mod _b S)) (mod _b (\ h → (Unit, is-prop-Unit)))))
      ( mod _b (\ (_ : (2 → S)) → (Unit, is-prop-Unit)))
      ( \ x → #let mod _b x' := x #in x')
      transpose-eq-is-pure_b


#def s-is-cov-i (f : 2 → S)
  : is-cov-i (\ b → first (f b))
  :=
    #let S-to-U
      := mod _b (\ (s : S) → first s) #in
    #let S-to-Unit_i
      := second (I-transpose (mod _b Unit) (mod _b S)) (mod _b (\ (s : 2 → S) → unit))
    #in
    #let U-to-U_i
      := mod _b (\ (x : U) → #let mod _b cov-map := (second (I-transpose (mod _b prop) Ub)) (mod _b (\x -> (is-cov-i x, is-prop-is-cov-i x))) #in cov-map x) #in
    #let Unit_i-to-U_i
      := second (I-transpose Ub (_I (mod _b Unit))) (mod _b (\ (u : 2 → b-extract (mod _b U) (_I (mod _b Unit))) → Unit)) #in
    #let f0 := #let mod _b u := U-to-U_i #in #let mod _b g := S-to-U #in mod _b (\ (s : S) → (u) ((g) s)) #in
    #let f1 := second (I-transpose (mod _b prop) (mod _b S)) (mod _b (\ h → (Unit, is-prop-Unit))) #in
    #let S-is-pullback
      : #let mod _b g := f0 #in #let mod _b h := f1 #in <| _b | (s : S) → (g) s = (h) s |>
      := mod _b (\ s → (#let mod _b p := prop-eq-in_I #in p) s)
    #in
    #let f0=f1
      : f0 = f1
      :=
        #let mod _b g := f0 #in
        #let mod _b h := f1 #in
        #let mod _b p := S-is-pullback #in
        crisp-induction-flat
          ( mod _b (S → b-extract (mod _b U) (_I (mod _b prop))))
          ( f0) (f1)
          ( mod _b (eq-htpy funext S (\ _ → b-extract (mod _b U) (_I (mod _b prop))) (g) (h) (p)))
    #in
    #let transposed-eq
      : ( \ (h : (2 → S)) → (is-cov-i (\ b → first (h b)), is-prop-is-cov-i (\ b → first (h b)))) =_{(2 -> S) -> prop} (\ (h : (2 → S)) → (Unit, is-prop-Unit))
      := concat
          ( ( 2 → S) → prop)
          ( \ h → (is-cov-i (\ b → first (h b)), is-prop-is-cov-i (\ b → first (h b))))
          ( #let mod _b tr := (first (I-transpose (mod _b prop) (mod _b S)) f0) #in tr)
          ( \ _ → (Unit, is-prop-Unit))
          ( rev
            ( ( 2 → S) → prop)
            ( #let mod _b tr := (first (I-transpose (mod _b prop) (mod _b S)) f0) #in tr)
            ( \ h → (is-cov-i (\ b → first (h b)), is-prop-is-cov-i (\ b → first (h b))))
            transpose-eq-is-cov)
          ( concat
            ( ( 2 → S) → prop)
            ( #let mod _b tr := (first (I-transpose (mod _b prop) (mod _b S)) f0) #in tr)
            ( #let mod _b tr := (first (I-transpose (mod _b prop) (mod _b S)) f1) #in tr)
            ( \ _ → (Unit, is-prop-Unit))
            ( ap
              ( <| _b | S → b-extract (mod _b U) (_I (mod _b prop)) |>)
              ( ( 2 → S) → prop)
              f0 f1
              ( \ f → #let mod _b tr := (first (I-transpose (mod _b prop) (mod _b S)) f) #in tr)
              f0=f1)
            transpose-eq-pure)
    #in
    transport U (\ A → A)
      Unit (is-cov-i (\ b → first (f b)))
      ( rev U
        ( is-cov-i (\ b → first (f b)))
        Unit
        ( ap prop U
          ( is-cov-i (\ b → first (f b)), is-prop-is-cov-i (\ b → first (f b)))
          ( Unit, is-prop-Unit)
          ( \ p → first p)
          ( htpy-eq
            ( 2 → S)
            ( \ _ → prop)
            ( \ h → (is-cov-i (\ b → first (h b)), is-prop-is-cov-i (\ b → first (h b))))
            ( \ _ → (Unit, is-prop-Unit))
            transposed-eq
            f)))
      unit

#def mor2fun (f : 2 → S)
  : Σ ( A : S) , (Σ (B : S) , (first A) → (first B))
  :=
  ( f 0₂ , (f 1₂ , coe-i (\ x → first (f x)) (s-is-cov-i f)))

#postulate dirglue-is-acov (A B : S) (f : (first A) -> (first B)) (i : 2) : is-a-cov (Sigma (b : (first B)),
      U [
        (i === 0_2) |-> fib (first A) (first B) f b,
        (i === 1_2) |-> Unit
      ])


#def dirglue (A B : S) (f : (first A) -> (first B))
  : 2 -> S
  :=
    #let tpe := \(i : 2) ->
      Sigma (b : (first B)),
      U [
        (i === 0_2) |-> fib (first A) (first B) f b,
        (i === 1_2) |-> Unit
      ]
    #in
    \i -> (tpe i, dirglue-is-acov A B f i)




#postulate id-2 (i : 2) : TOPE

-- #postulate dirglue_0=A (A B : S) (f : (first A) -> (first B)) : dirglue A B f 0_2 = A

-- #postulate dirglue_1=B (A B : S) (f : (first A) -> (first B)) : dirglue A B f 0_2 = B

-- #postulate mor2fun-dirglue=f (A B : S) (f : (first A) -> (first B)) : mor2fun (dirglue A B f) = (first A, first B, f)

